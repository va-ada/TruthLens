# ============================================================
# TruthLens — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to Git.
# ============================================================

# --- LLM Provider API Keys ---
# At least one key is required for cloud-based fact verification.
# If none are set, TruthLens falls back to its offline NLI engine.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
OPENAI_API_KEY=

# --- LLM Provider Selection ---
# Options: auto, gemini, groq, openai, offline
# "auto" tries Gemini → Groq → OpenAI → offline fallback
DEFAULT_LLM_PROVIDER=auto

# Model names (Google retires old ones; list yours with GET https://generativelanguage.googleapis.com/v1beta/models)
GEMINI_MODEL=gemini-2.5-flash
# Tried in order if the main model is overloaded (HTTP 503) or unavailable. Older models are preferred: newer previews are often overloaded
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (optional, for local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding Model ---
# Default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- RAG Hyperparameters ---
RETRIEVAL_TOP_K=12
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=450
CHUNK_OVERLAP=60

# --- Security ---
# Required header (X-Admin-Token) for upload/delete/seed/news-sync endpoints.
# Leave empty ONLY for local development.
ADMIN_TOKEN=
# Comma-separated origins allowed to call the API from another site (e.g. https://myapp.example).
# The bundled UI is same-origin and needs nothing here.
ALLOWED_ORIGINS=

# --- Docker ---
# Host port for `docker compose up` (container always listens on 8000)
TRUTHLENS_PORT=8000

# --- Production (docker-compose.prod.yml) ---
# Public hostname for Caddy HTTPS (localhost for a local test)
DOMAIN=
# Container memory cap
TRUTHLENS_MEM_LIMIT=3g

# --- Production (public deployment) ---
# "production" refuses to start unless ADMIN_TOKEN is set (>= 16 chars) and hides /docs, /redoc, /openapi.json
APP_ENV=development
# 1 = trust the left-most X-Forwarded-For entry for the client IP (only behind a proxy you control, e.g. Caddy)
TRUST_PROXY=0
# Per-client-IP requests per rolling minute (HTTP 429 + Retry-After when exceeded)
VERIFY_RATE_PER_MIN=10
URL_EXTRACT_RATE_PER_MIN=10
FEEDBACK_RATE_PER_MIN=5
UPLOAD_RATE_PER_MIN=5
# Identical claims reuse the verdict for this many seconds (0 disables); bounded LRU size
CACHE_TTL_S=21600
CACHE_MAX_ENTRIES=1000
# Max cloud-LLM calls per UTC day across the server (0 = unlimited); beyond it the offline judge is used
LLM_DAILY_BUDGET=500
# Verification history and verdict-feedback retention (days)
HISTORY_RETENTION_DAYS=30
FEEDBACK_RETENTION_DAYS=90
# Content-Security-Policy override (empty = built-in default for a self-hosted, pre-built frontend)
CSP=
# Contact shown to Wikipedia in the User-Agent (their API policy requires one): your email or site URL
OPERATOR_CONTACT=

# --- Performance / retrieval ---
# Offline judge model. base: more accurate; small (cross-encoder/nli-deberta-v3-small): ~2x faster on CPU-only servers
NLI_MODEL=cross-encoder/nli-deberta-v3-base
# Max concurrent Wikipedia API requests per process (Wikipedia returns HTTP 429 when pushed harder)
WIKI_MAX_INFLIGHT=4
# Cache identical Wikipedia API responses for this many seconds (0 = off)
WIKI_CACHE_TTL_S=21600
# Per-call timeout for cloud LLM judges (seconds)
LLM_TIMEOUT_S=20
# Verifications in flight per container before new ones get 503 'busy, retry' (offline judge is CPU-bound)
MAX_CONCURRENT_VERIFICATIONS=4
