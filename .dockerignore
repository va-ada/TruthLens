# ============================================
# TruthLens — Docker Ignore
# ============================================
# Keeps the image lean by excluding dev/build artifacts
# while preserving everything the app actually needs.

# Version control
.git
.gitignore

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments (host-local only)
env/
venv/
.venv/
.eggs/
*.egg-info/
build/
dist/

# Environment secrets (never bake into image)
.env
.env.*

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Test & scratch files
scratch/
test_*.txt
test_out.txt
debug_*.py
*.pytest_cache
.pytest_cache/
htmlcov/
coverage/
.coverage

# Large raw datasets (not needed at runtime)
data/raw/
data/processed/

# Local ChromaDB (mounted as volume at runtime)
chroma_db/

# Local SQLite DB (mounted as volume at runtime)
backend/database/*.db

# Documentation & media not needed in image
TruthLens-data.md
docs/
*.md
!README.md

# Docker files themselves
Dockerfile
docker-compose.yml

# Gemini agent / IDE artifacts
.gemini/
.agents/

# Tests, logs, local runtime data
tests/
backend/tests/
*.log
data/uploads/
storage/
backups/

# Frontend build tooling (built assets in static/ ARE shipped)
node_modules/
